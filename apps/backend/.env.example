APP_ENV=development
APP_NAME=SIMA
APP_DEBUG=true

DATABASE_URL=postgresql+psycopg://sima:change-me-local-only@localhost:5432/sima

FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

SESSION_COOKIE_NAME=sima_session
SESSION_SECRET=development-only-change-me
SESSION_TTL_SECONDS=28800
CSRF_SECRET=development-only-change-me

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_SECONDS=900

FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=../../runtime/uploads
MAX_UPLOAD_SIZE_MB=20

LOG_LEVEL=INFO

# Development seed only; never reuse this password outside local development.
DEV_SEED_PASSWORD=SimaDev-2026!
