APP_ENV=development
APP_NAME=SIMA
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://sima:change-me-local-only@localhost:5432/sima
SESSION_COOKIE_NAME=sima_session
SESSION_SECRET=replace-with-long-random-local-secret
SESSION_TTL_SECONDS=28800
CSRF_SECRET=replace-with-long-random-local-csrf-secret
FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=../../runtime/uploads
MAX_UPLOAD_SIZE_MB=20
LOG_LEVEL=INFO
